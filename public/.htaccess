# Redirect all non-canonical homepage variants to https://aikonx.com.au/ in a single 301
RewriteEngine On

# /tradies is not a real page; send it to the canonical industry page (single 301)
RewriteRule ^tradies/?$ https://aikonx.com.au/industries/tradies/ [R=301,L]

# Rule 1: HTTP non-www -> HTTPS non-www (single 301)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^aikonx\.com\.au$ [NC]
RewriteRule ^(.*)$ https://aikonx.com.au/$1 [R=301,L]

# Rule 2: HTTP www -> HTTPS non-www (single 301)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^www\.aikonx\.com\.au$ [NC]
RewriteRule ^(.*)$ https://aikonx.com.au/$1 [R=301,L]

# Static asset caching: 7 days for root-level and nested static files (HTML is not matched).
# Bump the ?v= query string (or rename the file) on the page references to invalidate.
# LocationMatch is not permitted in .htaccess files.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|webp|png|jpe?g|gif|svg|ico|woff2?|mp4)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# Rule 3: HTTPS www -> HTTPS non-www (single 301)
RewriteCond %{HTTPS} on
RewriteCond %{HTTP_HOST} ^www\.aikonx\.com\.au$ [NC]
RewriteRule ^(.*)$ https://aikonx.com.au/$1 [R=301,L]

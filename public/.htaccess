# Long-lived immutable cache for Vite-fingerprinted assets (hash in filename = safe to cache forever)
<IfModule mod_expires.c>
  ExpiresActive On
  # Fingerprinted JS/CSS/images/fonts — 1 year
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|webp|avif|svg|woff|woff2|ttf|eot|mp4|ico)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|webp|avif|svg|woff|woff2|ttf|eot|mp4|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML must revalidate so updates are always fetched
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# Redirect all non-canonical homepage variants to https://aikonx.com.au/ in a single 301
RewriteEngine On

# Rule 1: HTTP non-www -> HTTPS non-www (single 301)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^aikonx\.com\.au$ [NC]
RewriteRule ^(.*)$ https://aikonx.com.au/$1 [R=301,L]

# Rule 2: HTTP www -> HTTPS non-www (single 301)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^www\.aikonx\.com\.au$ [NC]
RewriteRule ^(.*)$ https://aikonx.com.au/$1 [R=301,L]

# Rule 3: HTTPS www -> HTTPS non-www (single 301)
RewriteCond %{HTTPS} on
RewriteCond %{HTTP_HOST} ^www\.aikonx\.com\.au$ [NC]
RewriteRule ^(.*)$ https://aikonx.com.au/$1 [R=301,L]
